# App
NEXT_PUBLIC_APP_URL=http://localhost:3410

# 介面語系："zh-TW"（預設，留空即是）或 "en"
# 在 build 時決定，執行期不切換；改完要重啟 dev server 或重新 build。
# 注意：e2e 測試斷言中文字串，跑 pnpm test:e2e 前要把這行清空。
NEXT_PUBLIC_LOCALE=

# Database（本機 demo 用 SQLite；換 PostgreSQL 時改 provider 與連線字串）
DATABASE_URL=file:./dev.db

# Supabase（MVP demo mode 不需要；接上時填入）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider："mock"（預設，不需金鑰）或 "anthropic"
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=

# TTS provider：
#   mock — 預設，不需金鑰，產生節奏對位的合成音軌
#   edge — Microsoft Edge 朗讀端點，真中文語音、免金鑰。
#          ⚠ 非官方端點，僅限開發／展示；正式上線請接付費供應商（同一介面替換）。
#          失敗時渲染自動退回 mock。
TTS_PROVIDER=mock
# edge 模式的聲線（選填）；預設 zh-TW-HsiaoChenNeural（台灣女聲）
EDGE_TTS_VOICE=

# 檔案儲存："local"（存 var/，由 /api/files 服務）
STORAGE_PROVIDER=local
